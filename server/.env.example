# ═══════════════════════════════════════════════════════════════════════════
#  Server Environment Configuration (Node.js / Express)
#  CRITICAL: Never commit your actual .env file or real secrets to version control!
# ═══════════════════════════════════════════════════════════════════════════

# Database Connection (MongoDB)
# Local development without Docker: mongodb://localhost:27017/lms-project-samriddhi-gyan
# Docker compose: mongodb://mongo:27017/lms-project-samriddhi-gyan
# Production MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/lms-project-samriddhi-gyan

# Server Port & Environment
PORT=10000
NODE_ENV=development

# Application & CORS URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URI=http://localhost:10000

# Security & Session Secrets (Generate strong random 64-char hex strings in production)
SECRET_KEY=your_jwt_signing_secret_here
SESSION_SECRET=your_express_session_secret_here

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 / S3-Compatible Video Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=samriddhi-gyan-videos
R2_PUBLIC_URL=https://pub-your_bucket_id.r2.dev

# Google OAuth 2.0 Credentials (Server-side only)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:10000/api/v1/user/google/callback

# Google Gemini AI API Key (Server-side only)
GEMINI_API_KEY=your_google_gemini_api_key

# Stripe Payment Gateway Keys (Server-side)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# eSewa Payment Gateway Configuration (Nepal)
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np

# SMTP Email Configuration (Optional / Transactional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASS=your_email_app_password
ACTIVATION_EXPIRY=86400000
EMAIL_USER=SamriddhiGyanService
