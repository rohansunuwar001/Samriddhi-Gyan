# ═══════════════════════════════════════════════════════════════════════════
#  Samriddhi Gyan LMS — Root .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# Environment files & secrets (CRITICAL)
.env
.env.*
*.env
*.env.*
*.local
!.env.example
!**/.env.example
!**/.env.local.example
key.png
# Client / Server specific environment files
client/.env
server/.env
hybrid_recommendation_server/.env

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production build artifacts
dist/
dist-ssr/
build/
client/dist/

# Uploads & generated media (never commit user data or videos)
uploads/
server/uploads/
public/hls/
server/public/hls/

# Python cache & virtual environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Dev scratch scripts & legacy directories
scratch/
server/scratch/
server2/
server3/
client/src/pages/GoogleAuthCallback.jsx