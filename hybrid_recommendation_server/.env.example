PROJECT_NAME="Samriddhi Gyan Hybrid Recommendation Service"
VERSION="1.0.0"
PORT=8001
HOST=0.0.0.0

# PostgreSQL Connection Details
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=samriddhi_gyan

# Optional full connection URI override (if set, overrides individual parameters above)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/samriddhi_gyan

# Application URLs
FRONTEND_URL=http://localhost:5173
MAIN_BACKEND_URL=http://localhost:10000

# Scheduler Interval (in minutes)
TRAINING_INTERVAL_MINUTES=60
