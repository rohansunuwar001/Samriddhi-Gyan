# ═══════════════════════════════════════════════════════════════════════════
#  Client Environment Configuration (Vite)
#  NOTE: Only public-safe variables with the VITE_ prefix should be placed here.
#  NEVER place database connection strings, secret keys, or private tokens here.
# ═══════════════════════════════════════════════════════════════════════════

# Backend API Base URL (e.g., http://localhost:10000 or production API URL)
VITE_BASE_URL=http://localhost:10000

# Stripe Publishable Key (Safe for client-side use)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Google Maps API Key (Ensure HTTP referrer restrictions are enabled in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

