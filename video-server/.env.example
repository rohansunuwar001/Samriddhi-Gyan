# ═══════════════════════════════════════════════════════════════════════════
#  Dedicated Video Transcoder Server Configuration
# ═══════════════════════════════════════════════════════════════════════════

PORT=8081
NODE_ENV=development
MAIN_SERVER_URL=http://localhost:10000
INTERNAL_SECRET_KEY=transcoder_internal_secret_change_me

# Backblaze B2 / S3 Storage Credentials
B2_KEY_ID=your_backblaze_application_key_id
B2_APPLICATION_KEY=your_backblaze_application_key
B2_BUCKET_NAME=samriddhi-gyan-videos
B2_REGION=us-west-004
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_PUBLIC_URL=https://your-bucket.s3.us-west-004.backblazeb2.com

# Google Gemini API Key for speech transcription (Optional)
GEMINI_API_KEY=your_google_gemini_api_key

# Transcoder Tuning
# Presets: ultrafast, superfast, veryfast, faster, fast
FFMPEG_PRESET=veryfast
# Concurrency limit for parallel chunk uploads to B2
B2_UPLOAD_CONCURRENCY=15
